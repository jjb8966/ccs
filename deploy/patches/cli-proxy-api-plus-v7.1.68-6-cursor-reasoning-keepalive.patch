+// sanitizeCursorToolCallID removes whitespace/newlines that Cursor sometimes
+// embeds in MCP tool call IDs. Those break OpenAI SSE JSON ("data: {...}")
+// because a raw newline terminates the SSE event mid-object.
+func sanitizeCursorToolCallID(id string) string {
+	if id == "" {
+		return id
+	}
+	// Prefer the last non-empty segment when Cursor concatenates IDs with \n.
+	parts := strings.FieldsFunc(id, func(r rune) bool {
+		return r == '\n' || r == '\r'
+	})
+	if len(parts) == 0 {
+		return strings.TrimSpace(id)
+	}
+	return strings.TrimSpace(parts[len(parts)-1])
+}
