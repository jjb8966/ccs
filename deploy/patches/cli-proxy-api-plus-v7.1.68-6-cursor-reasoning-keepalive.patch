+// decodeInteractionQuery parses ASM field 7 (InteractionQuery). Cursor sends this
+// when the model wants built-in web/exa search; the client must reply with
+// AgentClientMessage.interaction_response or the stream hangs forever.
+func decodeInteractionQuery(data []byte, msg *DecodedServerMessage) {
+	msg.Type = ServerMsgInteractionQuery
+	for len(data) > 0 {
+		num, typ, n := protowire.ConsumeTag(data)
+		if n < 0 {
+			return
+		}
+		data = data[n:]
+		switch typ {
+		case protowire.VarintType:
+			val, n := protowire.ConsumeVarint(data)
+			if n < 0 {
+				return
+			}
+			data = data[n:]
+			if num == 1 { // id is uint32
+				msg.InteractionQueryID = uint32(val)
+			}
+		case protowire.BytesType:
+			val, n := protowire.ConsumeBytes(data)
+			if n < 0 {
+				return
+			}
+			data = data[n:]
+			switch {
+			case num >= 2 && num <= 8: // web_search / ask_question / switch_mode / exa_* / create_plan / setup_vm
+				msg.InteractionQueryKind = int(num)
+				extractInteractionQueryArgs(val, msg)
+			case num >= 9: // newer Cursor InteractionQuery oneofs — capture kind, reject later
+				msg.InteractionQueryKind = int(num)
+				extractInteractionQueryArgs(val, msg)
+				log.Debugf("decodeInteractionQuery: newer bytes field %d len=%d (will reject if unsupported)", num, len(val))
+			default:
+				log.Debugf("decodeInteractionQuery: unknown bytes field %d len=%d", num, len(val))
+			}
+		default:
+			n := protowire.ConsumeFieldValue(num, typ, data)
+			if n < 0 {
+				return
+			}
+			data = data[n:]
+		}
+	}
+	log.Debugf("decodeInteractionQuery: id=%d kind=%d term=%q", msg.InteractionQueryID, msg.InteractionQueryKind, msg.InteractionQueryTerm)
+}
