+func extractInteractionQueryArgs(data []byte, msg *DecodedServerMessage) {
+	for len(data) > 0 {
+		num, typ, n := protowire.ConsumeTag(data)
+		if n < 0 {
+			return
+		}
+		data = data[n:]
+		if typ != protowire.BytesType {
+			n = protowire.ConsumeFieldValue(num, typ, data)
+			if n < 0 {
+				return
+			}
+			data = data[n:]
+			continue
+		}
+		val, n := protowire.ConsumeBytes(data)
+		if n < 0 {
+			return
+		}
+		data = data[n:]
+		if num == 1 { // args wrapper or direct string
+			// Try nested args first
+			nestedTerm := ""
+			nestedID := ""
+			rest := val
+			for len(rest) > 0 {
+				nnum, ntyp, nn := protowire.ConsumeTag(rest)
+				if nn < 0 {
+					break
+				}
+				rest = rest[nn:]
+				if ntyp != protowire.BytesType {
+					nn = protowire.ConsumeFieldValue(nnum, ntyp, rest)
+					if nn < 0 {
+						break
+					}
+					rest = rest[nn:]
+					continue
+				}
+				nval, nn := protowire.ConsumeBytes(rest)
+				if nn < 0 {
+					break
+				}
+				rest = rest[nn:]
+				switch nnum {
+				case 1: // search_term / query
+					nestedTerm = string(nval)
+				case 2: // tool_call_id
+					nestedID = string(nval)
+				}
+			}
+			if nestedTerm != "" {
+				msg.InteractionQueryTerm = nestedTerm
+			} else if msg.InteractionQueryTerm == "" {
+				msg.InteractionQueryTerm = string(val)
+			}
+			if nestedID != "" && msg.McpToolCallId == "" {
+				msg.McpToolCallId = nestedID
+			}
+		} else if num == 2 && msg.McpToolCallId == "" {
+			msg.McpToolCallId = string(val)
+		}
+	}
+}
