+// EncodeExecUnknownRejected responds to ExecServerMessage oneof fields that are
+// missing from the embedded agent.proto descriptor (e.g. field 28 = Cursor
+// built-in web/docs search). Without a reply the H2 session waits forever and
+// OpenAI clients see a hang after the model announces it will "check".
+//
+// Wire format mirrors common Cursor tool results: field N { error { error } }.
+func EncodeExecUnknownRejected(execMsgId uint32, execId string, fieldNumber int, reason string) []byte {
+	if fieldNumber <= 0 {
+		fieldNumber = 28
+	}
+	if reason == "" {
+		reason = "Tool not available in this environment."
+	}
+
+	// Prefer error=2 (FetchResult/WebSearchResult shape). Field 28 may not have
+	// rejected=3 in the live schema.
+	errInner := protowire.AppendTag(nil, 1, protowire.BytesType)
+	errInner = protowire.AppendString(errInner, reason)
+	result := protowire.AppendTag(nil, 2, protowire.BytesType)
+	result = protowire.AppendBytes(result, errInner)
+
+	return encodeRawExecClientMsg(execMsgId, execId, fieldNumber, result)
+}
+
+// EncodeExecUnknownSuccess replies to an unknown exec field with a success
+// payload shaped like FetchSuccess / McpSuccess: field 1 { content/text }.
+func EncodeExecUnknownSuccess(execMsgId uint32, execId string, fieldNumber int, content string) []byte {
+	if fieldNumber <= 0 {
+		fieldNumber = 28
+	}
+	success := protowire.AppendTag(nil, 1, protowire.BytesType)
+	success = protowire.AppendString(success, content) // url-or-unused
+	success = protowire.AppendTag(success, 2, protowire.BytesType)
+	success = protowire.AppendString(success, content) // content/text
+	success = protowire.AppendTag(success, 3, protowire.VarintType)
+	success = protowire.AppendVarint(success, 200) // status_code if Fetch-shaped
+
+	result := protowire.AppendTag(nil, 1, protowire.BytesType)
+	result = protowire.AppendBytes(result, success)
+	return encodeRawExecClientMsg(execMsgId, execId, fieldNumber, result)
+}
+
+func encodeRawExecClientMsg(execMsgId uint32, execId string, fieldNumber int, result []byte) []byte {
+	ecm := protowire.AppendTag(nil, ECM_Id, protowire.VarintType)
+	ecm = protowire.AppendVarint(ecm, uint64(execMsgId))
+	ecm = protowire.AppendTag(ecm, ECM_ExecId, protowire.BytesType)
+	ecm = protowire.AppendString(ecm, execId)
+	ecm = protowire.AppendTag(ecm, protowire.Number(fieldNumber), protowire.BytesType)
+	ecm = protowire.AppendBytes(ecm, result)
+
+	acm := protowire.AppendTag(nil, ACM_ExecClientMessage, protowire.BytesType)
+	acm = protowire.AppendBytes(acm, ecm)
+	return acm
+}
+
+// EncodeInteractionQueryApproved replies to ASM InteractionQuery (field 7) with
+// an approved InteractionResponse so Cursor can continue the built-in search.
+// queryKind mirrors InteractionQuery oneof field numbers (2=web_search, 5=exa_search, ...).
+func EncodeInteractionQueryApproved(queryID uint32, queryKind int) []byte {
+	if queryKind <= 0 {
+		queryKind = 2 // web_search_request_response
+	}
+	// InteractionResponse response oneof field numbers match query kinds:
+	// 2 web_search, 3 ask_question, 4 switch_mode, 5 exa_search, 6 exa_fetch, 7 create_plan, 8 setup_vm
+	approved := []byte{} // empty Approved message is valid for web/exa search
+	respOneof := protowire.AppendTag(nil, 1, protowire.BytesType) // approved = 1
+	respOneof = protowire.AppendBytes(respOneof, approved)
+
+	ir := protowire.AppendTag(nil, 1, protowire.VarintType) // id is uint32
+	ir = protowire.AppendVarint(ir, uint64(queryID))
+	ir = protowire.AppendTag(ir, protowire.Number(queryKind), protowire.BytesType)
+	ir = protowire.AppendBytes(ir, respOneof)
+
+	acm := protowire.AppendTag(nil, ACM_InteractionResponse, protowire.BytesType)
+	acm = protowire.AppendBytes(acm, ir)
+	return acm
+}
+
+// EncodeInteractionQueryRejected rejects an InteractionQuery so the model can
+// continue without the built-in tool.
+func EncodeInteractionQueryRejected(queryID uint32, queryKind int, reason string) []byte {
+	if queryKind <= 0 {
+		queryKind = 2
+	}
+	if reason == "" {
+		reason = "Tool not available in this environment."
+	}
+	rej := protowire.AppendTag(nil, 1, protowire.BytesType)
+	rej = protowire.AppendString(rej, reason)
+	respOneof := protowire.AppendTag(nil, 2, protowire.BytesType) // rejected = 2
+	respOneof = protowire.AppendBytes(respOneof, rej)
+
+	ir := protowire.AppendTag(nil, 1, protowire.VarintType)
+	ir = protowire.AppendVarint(ir, uint64(queryID))
+	ir = protowire.AppendTag(ir, protowire.Number(queryKind), protowire.BytesType)
+	ir = protowire.AppendBytes(ir, respOneof)
+
+	acm := protowire.AppendTag(nil, ACM_InteractionResponse, protowire.BytesType)
+	acm = protowire.AppendBytes(acm, ir)
+	return acm
+}
