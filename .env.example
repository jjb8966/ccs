# CCS dev stack — copy to .env and adjust
#   cp .env.example .env

# Claude Code / nginx Bearer token (must match cliproxy.auth.api_key in container config)
CCS_PROXY_TOKEN=ccs-change-me-8Kp2mQx7

# Docker container name (default: ccs)
# CCS_CONTAINER_NAME=ccs

# Public URL (nginx → ccs:8317). Used in ~/agent/claude-code/settings.env.json
CCS_PUBLIC_HOST=jjb8966.duckdns.org
CCS_PUBLIC_PATH=/ccs

# Host ports (docker publish)
CCS_CLIPROXY_PORT=8320
CCS_DASHBOARD_PORT=3000

# Cursor model id for Claude Code
CCS_CURSOR_MODEL=composer-2.5

# Force headless Cursor auth (SSH): ./auth-cursor-headless.sh or CCS_AUTH_HEADLESS=1 ./auth-cursor.sh
# CCS_AUTH_HEADLESS=1
